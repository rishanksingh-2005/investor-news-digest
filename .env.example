# Copy this file to ".env" and fill in only what you need. Never commit .env.
#
# The summariser is chosen with --provider (default: ollama, which needs no key).
# Keys below are only required for the matching provider / optional source.

# --provider anthropic
ANTHROPIC_API_KEY=
# --provider openai
OPENAI_API_KEY=

# Optional Finnhub news source. Use your own free key from https://finnhub.io/register
# (free plan: US listings, 60 calls/min). Skipped if empty. No quotes needed.
FINNHUB_API_KEY=

# SEC EDGAR (US filings) requires your name and email, e.g.:
# SEC_USER_AGENT=Jane Smith jane@example.com
SEC_USER_AGENT=

# After filling this in, test everything with:  python "news digest.py" --doctor

# Default watchlist file when --watchlist isn't given (.xlsx, .csv, .tsv, .json, .txt).
# Leave empty to use watchlist.* next to the script, or the bundled example.
WATCHLIST=

# Email delivery (optional; set smtp_host, smtp_user and email_to in config.yaml).
# Gmail / Microsoft 365 need an app password here, not your normal password.
SMTP_PASSWORD=
